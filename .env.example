# Copy to .env.local for local testing, and add the same names in Vercel → Settings → Environment Variables.
# Everything here is optional: with nothing set, the site works and form submissions only reach the server log.

# Neon Postgres: saves applications and contact messages. The Vercel Neon integration sets this for you;
# otherwise copy the pooled connection string from the Neon dashboard's Connect button.
DATABASE_URL=

# Resend: emails each application and contact message to Aidan.
RESEND_API_KEY=
# Where those emails go. Until a domain is verified in Resend, this must be the email the Resend account was made with.
NOTIFY_EMAIL=
# Sender, once a domain is verified in Resend, e.g. Stringline <hello@stringline.com>. Leave blank until then.
EMAIL_FROM=

# Link for booking an intro call, shown on /apply/thanks. The box stays hidden while this is blank.
NEXT_PUBLIC_BOOKING_URL=

# The public site address once the domain exists, e.g. https://stringline.com
NEXT_PUBLIC_SITE_URL=
